{
  "name": "401 maps to AuthenticationError with the body's code",
  "request": { "method": "GET", "path": "/health", "headers": {}, "body": null },
  "response": {
    "status": 401,
    "headers": { "content-type": "application/json" },
    "body": {
      "error": {
        "type": "authentication_error",
        "code": "invalid_api_key",
        "message": "Invalid API key",
        "request_id": "req_conf_2"
      }
    }
  },
  "expect": {
    "call": "health.get",
    "args": [],
    "error": { "class": "AuthenticationError", "status": 401, "code": "invalid_api_key" }
  }
}
