{
  "name": "@ligaxai/widget",
  "version": "0.0.0",
  "description": "Drop-in chat assistant for any website: one script tag, a <ligax-chat> custom element, or a React component",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ligaxai/ligaxai-typescript.git",
    "directory": "packages/widget"
  },
  "homepage": "https://github.com/ligaxai/ligaxai-typescript#readme",
  "bugs": "https://github.com/ligaxai/ligaxai-typescript/issues",
  "keywords": [
    "ligaxai-typescript",
    "widget",
    "chat",
    "embed",
    "web-component"
  ],
  "type": "module",
  "sideEffects": [
    "./dist/widget.global.js"
  ],
  "engines": {
    "node": ">=22"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "main": "./dist/index.cjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.mts",
  "unpkg": "./dist/widget.global.js",
  "jsdelivr": "./dist/widget.global.js",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.mts",
        "default": "./dist/index.mjs"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./react": {
      "import": {
        "types": "./dist/react.d.mts",
        "default": "./dist/react.mjs"
      },
      "require": {
        "types": "./dist/react.d.cts",
        "default": "./dist/react.cjs"
      }
    },
    "./widget.global.js": "./dist/widget.global.js",
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "tsdown",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run"
  },
  "dependencies": {
    "@ligaxai/sdk": "workspace:*"
  },
  "peerDependencies": {
    "react": ">=18"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "jsdom": "29.1.1",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "publishConfig": {
    "access": "public"
  }
}
