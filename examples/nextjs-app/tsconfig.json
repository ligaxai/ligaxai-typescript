{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "jsx": "preserve",
    "lib": ["DOM", "DOM.Iterable", "ES2022"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "allowJs": true,
    "incremental": false,
    "plugins": [{ "name": "next" }],
    "types": ["react", "react-dom"]
  },
  "include": ["next-env.d.ts", "app/**/*.ts", "app/**/*.tsx", "next.config.ts"],
  "exclude": ["node_modules", ".next"]
}
