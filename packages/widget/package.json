{
  "name": "@ligaxai/widget",
  "version": "0.0.0",
  "description": "Drop-in chat widget for LigaX AI — one script tag, no framework",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ligaxai/ligaxai-typescript.git",
    "directory": "packages/widget"
  },
  "homepage": "https://github.com/ligaxai/ligaxai-typescript#readme",
  "bugs": "https://github.com/ligaxai/ligaxai-typescript/issues",
  "keywords": [
    "ligaxai-typescript",
    "widget",
    "chat",
    "embed"
  ],
  "type": "module",
  "sideEffects": false,
  "engines": {
    "node": ">=22"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "main": "./dist/index.cjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.mts",
  "unpkg": "./dist/widget.global.js",
  "jsdelivr": "./dist/widget.global.js",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.mts",
        "default": "./dist/index.mjs"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./widget.global.js": "./dist/widget.global.js",
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "tsdown",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run"
  },
  "dependencies": {
    "@ligaxai/sdk": "workspace:*"
  },
  "devDependencies": {
    "jsdom": "29.1.1"
  },
  "publishConfig": {
    "access": "public"
  }
}
