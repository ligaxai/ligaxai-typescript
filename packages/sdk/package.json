{
  "name": "@base-project-scope/sdk",
  "version": "0.0.0",
  "description": "Official __PROJECT_TITLE__ TypeScript SDK",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/__GITHUB_ORG__/base-project-slug.git",
    "directory": "packages/sdk"
  },
  "homepage": "https://github.com/__GITHUB_ORG__/base-project-slug#readme",
  "bugs": "https://github.com/__GITHUB_ORG__/base-project-slug/issues",
  "keywords": [
    "base-project-slug",
    "sdk",
    "api",
    "client"
  ],
  "type": "module",
  "sideEffects": false,
  "engines": {
    "node": ">=22"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "main": "./dist/index.cjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.mts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.mts",
        "default": "./dist/index.mjs"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./next": {
      "import": {
        "types": "./dist/next.d.mts",
        "default": "./dist/next.mjs"
      },
      "require": {
        "types": "./dist/next.d.cts",
        "default": "./dist/next.cjs"
      }
    },
    "./ai-sdk": {
      "import": {
        "types": "./dist/ai-sdk.d.mts",
        "default": "./dist/ai-sdk.mjs"
      },
      "require": {
        "types": "./dist/ai-sdk.d.cts",
        "default": "./dist/ai-sdk.cjs"
      }
    },
    "./webhooks": {
      "import": {
        "types": "./dist/webhooks.d.mts",
        "default": "./dist/webhooks.mjs"
      },
      "require": {
        "types": "./dist/webhooks.d.cts",
        "default": "./dist/webhooks.cjs"
      }
    },
    "./errors": {
      "import": {
        "types": "./dist/errors.d.mts",
        "default": "./dist/errors.mjs"
      },
      "require": {
        "types": "./dist/errors.d.cts",
        "default": "./dist/errors.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "tsdown",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run"
  },
  "dependencies": {
    "eventsource-parser": "4.1.2"
  },
  "peerDependencies": {
    "ai": ">=6",
    "next": ">=15"
  },
  "peerDependenciesMeta": {
    "ai": {
      "optional": true
    },
    "next": {
      "optional": true
    }
  },
  "devDependencies": {
    "ai": "7.0.148",
    "zod": "4.6.7"
  },
  "publishConfig": {
    "access": "public"
  }
}
