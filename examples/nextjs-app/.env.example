# Server-only. Never prefix these with NEXT_PUBLIC_.
LIGAX_API_KEY=lgx_sk_...
LIGAX_PROFILE_ID=prf_...
# Required: your platform's API root, e.g. https://<your-ligax-host>/api/public/v1
LIGAX_BASE_URL=
# Direct mode (/direct): the browser needs the same API root — not a secret. Required there:
NEXT_PUBLIC_LIGAX_BASE_URL=

# Local try-out only: sign everyone in as this one user (ignored in production builds).
# Replace lib/session.ts with your own auth before deploying.
LIGAX_DEMO_USER=
